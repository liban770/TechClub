{
  "version": 2,
  "builds": [
    {
      "src": "techclub_core/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "includeFiles": [
          "templates/**",
          "static/**",
          "seed_data.py"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "techclub_core/wsgi.py"
    }
  ]
}
